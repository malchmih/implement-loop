#!/usr/bin/env python3
"""Run the Implement Loop command-line interface."""

import sys

if sys.version_info < (3, 11):  # noqa: UP036 - fail clearly before importing Python 3.11 APIs
    print("Error: implement-loop requires Python 3.11 or later.", file=sys.stderr)
    raise SystemExit(2)

from implement_loop.cli import main


if __name__ == "__main__":
    raise SystemExit(main())
